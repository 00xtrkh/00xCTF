# =========================================
# Root-level ignores
# =========================================
ME.md
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar

# =========================================
# Backend (Spring/Java) ignores
# =========================================
backend/target/
backend/build/
!backend/src/main/**/target/
!backend/src/test/**/target/
!backend/src/main/**/build/
!backend/src/test/**/build/

# IDE files (Spring/STS, IntelliJ, VS Code)
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache

backend/.idea
backend/*.iws
backend/*.iml
backend/*.ipr

# =========================================
# Frontend (Node/React/Vue) ignores
# =========================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.vite/
frontend/.parcel-cache/

# IDE files
frontend/.vscode/
frontend/.idea
frontend/*.iml
frontend/*.ipr

# =========================================
# NetBeans specific (if ever used)
# =========================================
backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/
